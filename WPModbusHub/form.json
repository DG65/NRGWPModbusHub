{
    "elements": [
        {
            "type": "ExpansionPanel",
            "caption": "📖 Dokumentation & Hilfe",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "name": "VersionInfo",
                    "caption": "ℹ️ WPModbusHub Version -- lokale Modbus-Anbindung für Wärmepumpen mehrerer Hersteller."
                },
                {
                    "type": "Label",
                    "caption": "Liest eine Wärmepumpe direkt per Modbus TCP im lokalen Netz aus -- ohne Internet, ohne Herstellerkonto. Details: https://github.com/DG65/NRGWPModbusHub"
                },
                {
                    "type": "Label",
                    "caption": "Ablauf: 1. Hersteller wählen → 2. IP-Adresse (bzw. IP des Modbus-Gateways) und Port eintragen → 3. Übernehmen → 4. „WPModbusHub aktiv“ einschalten und erneut übernehmen."
                },
                {
                    "type": "Button",
                    "caption": "🔄 Übernehmen erzwingen (ohne Formularänderung)",
                    "confirm": "Wirklich ApplyChanges() erzwingen? Praktisch direkt nach einem Modul-Update über die Modulverwaltung.",
                    "onClick": "IPS_ApplyChanges($id); echo '✅ ApplyChanges() ausgeführt.';"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "GeneralPanel",
            "caption": "🔧 Allgemein",
            "expanded": true,
            "items": [
                {
                    "type": "CheckBox",
                    "name": "WPMBHUB_Active",
                    "caption": "WPModbusHub aktiv"
                },
                {
                    "type": "NumberSpinner",
                    "name": "WPMBHUB_Interval",
                    "caption": "Aktualisierungsintervall (Sekunden)",
                    "minimum": 30,
                    "maximum": 600,
                    "suffix": " s"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "ConnectionPanel",
            "caption": "🔌 Wärmepumpe (Modbus TCP)",
            "expanded": true,
            "items": [
                {
                    "type": "Select",
                    "name": "Manufacturer",
                    "caption": "Hersteller",
                    "options": [
                        {"caption": "NIBE (S-Serie, z. B. S1155/S1255/S2125)", "value": "nibe"},
                        {"caption": "Stiebel Eltron (ISG-Gateway, WPMsystem/WPM3/WPM3i/LWZ)", "value": "stiebeleltron"},
                        {"caption": "LG Therma V", "value": "lg"},
                        {"caption": "Samsung EHS (über MIM-B19N-Zubehörmodul)", "value": "samsung"},
                        {"caption": "Waterkotte (EcoTouch-Regler)", "value": "waterkotte"},
                        {"caption": "IDM Energiesysteme (Navigatorregelung 2.0, z. B. ALM)", "value": "idm"},
                        {"caption": "Proxon T300 (Zimmermann, via Modbus-TCP-Gateway)", "value": "proxon"}
                    ],
                    "onChange": "WPMBHUB_OnChangeManufacturer($id, $Manufacturer);"
                },
                {
                    "type": "Label",
                    "name": "ManufacturerConfidence",
                    "caption": ""
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "ValidationTextBox",
                            "name": "Host",
                            "caption": "IP-Adresse (Wärmepumpe bzw. Modbus-Gateway)"
                        },
                        {
                            "type": "PopupButton",
                            "caption": "Wo finde ich die IP-Adresse?",
                            "width": "460px",
                            "popup": {
                                "caption": "Wo finde ich die IP-Adresse?",
                                "items": [
                                    {
                                        "type": "Label",
                                        "caption": "Bei NIBE S-Serie, Stiebel Eltron (ISG), Waterkotte (EcoTouch) und IDM (Navigatorregelung) ist das die IP-Adresse der Wärmepumpe/des Reglers selbst im lokalen Netz -- unter „Modbus TCP/IP“ bzw. im Netzwerkmenü des Reglers sichtbar/einstellbar. Bei LG, Samsung und Proxon ist es die IP-Adresse des dazwischengeschalteten Modbus-Gateways (z. B. ein RS485-zu-Ethernet-Adapter im „Modbus TCP zu RTU“-Modus, das offizielle MIM-B19N-Modul, oder bei Proxon ein passender RS485-Gateway vor dem werksseitig seriellen Anschluss)."
                                    }
                                ]
                            }
                        }
                    ]
                },
                {
                    "type": "NumberSpinner",
                    "name": "Port",
                    "caption": "Port",
                    "minimum": 1,
                    "maximum": 65535
                },
                {
                    "type": "NumberSpinner",
                    "name": "UnitId",
                    "caption": "Unit-ID / Slave-ID",
                    "minimum": 1,
                    "maximum": 247
                }
            ]
        }
    ],
    "status": [
        {
            "code": 201,
            "icon": "error",
            "caption": "Wärmepumpe nicht erreichbar -- IP-Adresse/Port/Unit-ID prüfen"
        }
    ]
}
