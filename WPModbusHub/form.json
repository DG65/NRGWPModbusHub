{
    "elements": [
        {
            "type": "ExpansionPanel",
            "caption": "📖 Documentation & help",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "name": "VersionInfo",
                    "caption": ""
                },
                {
                    "type": "Label",
                    "caption": "Reads a heat pump directly via Modbus TCP on the local network -- without internet, without a manufacturer account. Details: https://github.com/DG65/NRGWPModbusHub"
                },
                {
                    "type": "Label",
                    "caption": "Steps: 1. Choose the manufacturer → 2. Enter the IP address (or the IP of the Modbus gateway) and port → 3. Apply → 4. Switch on \"WPModbusHub active\" and apply again."
                },
                {
                    "type": "Button",
                    "caption": "🔄 Force apply (without a form change)",
                    "confirm": "Really force ApplyChanges()? Handy right after a module update via the module control.",
                    "onClick": "IPS_ApplyChanges($id); echo '✅ ApplyChanges()';"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "GeneralPanel",
            "caption": "🔧 General",
            "expanded": true,
            "items": [
                {
                    "type": "CheckBox",
                    "name": "WPMBHUB_Active",
                    "caption": "WPModbusHub active"
                },
                {
                    "type": "NumberSpinner",
                    "name": "WPMBHUB_Interval",
                    "caption": "Update interval (seconds)",
                    "minimum": 30,
                    "maximum": 600,
                    "suffix": " s"
                },
                {
                    "type": "Label",
                    "caption": "📈 Archiving: the module never switches on logging in the Symcon archive by itself. With the button below you deliberately enable it for all measured values (floating-point variables) of this instance, e.g. for charts and evaluations. Logging that is already enabled stays untouched."
                },
                {
                    "type": "Button",
                    "caption": "📈 Enable logging for the measured values",
                    "onClick": "echo WPMBHUB_EnableArchiving($id);"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "ConnectionPanel",
            "caption": "🔌 Heat pump (Modbus TCP)",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "name": "ConnectionStatus",
                    "caption": ""
                },
                {
                    "type": "Select",
                    "name": "Manufacturer",
                    "caption": "Manufacturer",
                    "options": [],
                    "onChange": "WPMBHUB_OnChangeManufacturer($id, $Manufacturer);"
                },
                {
                    "type": "Label",
                    "name": "ManufacturerConfidence",
                    "caption": ""
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "ValidationTextBox",
                            "name": "Host",
                            "caption": "IP address (heat pump or Modbus gateway)"
                        },
                        {
                            "type": "PopupButton",
                            "caption": "Where do I find the IP address?",
                            "width": "460px",
                            "popup": {
                                "caption": "Where do I find the IP address?",
                                "items": [
                                    {
                                        "type": "Label",
                                        "caption": "For NIBE S series, Stiebel Eltron (ISG), Waterkotte (EcoTouch) and IDM (Navigator control) this is the IP address of the heat pump/controller itself on the local network -- visible/adjustable under \"Modbus TCP/IP\" or in the network menu of the controller. For LG, Samsung and Proxon it is the IP address of the Modbus gateway in between (e.g. an RS485-to-Ethernet adapter in \"Modbus TCP to RTU\" mode, the official MIM-B19N module, or for Proxon a suitable RS485 gateway in front of the factory serial connection)."
                                    }
                                ]
                            }
                        }
                    ]
                },
                {
                    "type": "NumberSpinner",
                    "name": "Port",
                    "caption": "Port",
                    "minimum": 1,
                    "maximum": 65535
                },
                {
                    "type": "NumberSpinner",
                    "name": "UnitId",
                    "caption": "Unit ID / slave ID",
                    "minimum": 1,
                    "maximum": 247
                }
            ]
        }
    ],
    "status": [
        {
            "code": 201,
            "icon": "error",
            "caption": "Heat pump not reachable -- check IP address/port/unit ID"
        }
    ]
}
